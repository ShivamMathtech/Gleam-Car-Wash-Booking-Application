# Copy to .env to override the defaults. Node 24 is required.
PORT=4000
HOST=127.0.0.1
DB_PATH=./data/gleam.sqlite
# Local demonstration only. Set false before Internet deployment.
DEMO_MODE=true
# Exact public origin; mandatory when DEMO_MODE=false. No trailing slash.
APP_ORIGIN=http://localhost:4000
COOKIE_SECURE=false
# Required on first production boot (DEMO_MODE=false); no default admin password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional real SMS provider when DEMO_MODE=false (never exposed to the frontend).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
